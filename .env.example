# ─────────────────────────────────────────────────────────────
# Sonika — environment scaffold. Copy to .env.local and fill in.
# Everything here is read server-side except NEXT_PUBLIC_* values,
# which are exposed to the browser. Secrets (service role, API keys)
# MUST NOT be prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Public site URL (used by metadata + auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Landing-page sign-up gate. Off ⇒ home page stays a "parked" teaser (Follow the
# build / email CTAs). Set to 1 at go-live to surface Sign up / Log in links —
# the /signup + /login pages work either way; this only controls the home page.
# NEXT_PUBLIC_SIGNUP_OPEN=1

# ── Supabase ──────────────────────────────────────────────────
# Local dev values come from `supabase start`. Browser uses the
# anon key (RLS-enforced). The service-role key bypasses RLS and is
# server-only — never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── External services ─────────────────────────────────────────
# Provisioning runs server-side only. Each integration is mocked
# until its key is present, so the app runs locally with none set.

# Force the whole provisioning chain (Claude/Vapi/Twilio) to mock even when
# real keys ARE set — so you can keep live keys here without spending money.
# Real provisioning (buys real numbers) only happens when this is unset/0.
# PROVISIONING_MOCK=1

# Claude — system-prompt generation (mocked unless set)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8        # optional override

# Vapi — voice assistant. Real path activates when VAPI_API_KEY is set.
# VAPI_API_KEY=
# VAPI_MODEL_PROVIDER=openai             # optional; voice agent LLM
# VAPI_MODEL=gpt-4o                       # optional
# VAPI_VOICE_PROVIDER=11labs              # optional
# VAPI_VOICE_ID=N2lVS1w4EtoT3dr4eOWO      # optional
# Webhook for end-of-call reports → call_logs. Must be a PUBLIC https URL
# (Vapi can't reach localhost; use a tunnel like ngrok in dev). Set on each
# assistant at creation. The secret is checked on incoming X-Vapi-Secret.
# VAPI_WEBHOOK_URL=https://your-domain.com/api/webhooks/vapi
# VAPI_WEBHOOK_SECRET=

# Twilio — phone numbers. Real path activates when TWILIO_ACCOUNT_SID is set.
# Auth uses a scoped API Key (SK…) + secret, NOT the master Auth Token.
# Create a Standard API Key in the Sonika project: Console → Account →
# API keys & tokens → Create API Key (the secret is shown once).
# TWILIO_ACCOUNT_SID=AC...                # identifies the project (still required)
# TWILIO_API_KEY_SID=SK...                # preferred auth (scoped, revocable)
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=                       # fallback: used only if API key is blank
# TWILIO_COUNTRY=US                       # optional
# TWILIO_AREA_CODE=                       # optional, e.g. 415

# Stripe — per-seat billing. Real path activates when STRIPE_SECRET_KEY is set;
# otherwise the billing page says "not configured" and provisioning isn't gated.
# Use test-mode keys (sk_test_…) during development — fully free.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...                # recurring per-seat price
# STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen` or the dashboard
# Keep Stripe wired up (checkout, portal, webhooks, seat sync all work) but DROP
# the "subscribe before provisioning" paywall — handy for local dev. Mirrors
# PROVISIONING_MOCK. Set BILLING_MOCK=1 (or true/yes) to ungate provisioning.
# BILLING_MOCK=1

# RESEND_API_KEY=
